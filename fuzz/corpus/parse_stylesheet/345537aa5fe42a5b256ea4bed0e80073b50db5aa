mark.secondary {
  --mark-back-color: #d32f2f;
}

mark.tertiary {
  --mark-back-color: #308732;
}

mark.tag {
  padding: calc(var(--universal-padding)/2) var(--universal-padding);
  border-radius: 1em;
}

