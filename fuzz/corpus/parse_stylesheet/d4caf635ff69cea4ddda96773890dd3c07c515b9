/* src/core/sanitize.css */
*,
::before,
::after {
  box-sizing: border-box;
  background-repeat: no-repeat;
}
::before,
::after {
  text-decoration: inherit;
  vertical-align: inherit;
}
:root {
  cursor: default;
  overflow-wrap: break-word;
  -webkit-tap-highlight-color: transparent;
  text-size-adjust: none;
